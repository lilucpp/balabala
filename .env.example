# balabala 环境变量配置
# 复制此文件为 .env 并填写你的真实信息
# 注意：.env 文件不应提交到Git！

# ============================================
# ALAPI 配置 (https://www.alapi.cn/)
# ============================================
# 获取方式：访问 https://www.alapi.cn/ 注册账号，在控制台获取Token
ALAPI_TOKEN=your_alapi_token_here

# ============================================
# Telegram Bot 配置
# ============================================
# Bot Token 获取方式：向 @BotFather 发送 /newbot 创建Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID 获取方式：向 @userinfobot 发送任意消息
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# Garmin Connect 配置
# ============================================
# 你的Garmin账号邮箱
GARMIN_USERNAME=your_garmin_email@example.com

# 你的Garmin密码
GARMIN_PASSWORD=your_garmin_password

# 区域设置: CN=中国区, US=国际区（默认）
GARMIN_REGION=CN
